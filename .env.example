# Server-only settings. Never prefix these with NEXT_PUBLIC_.
# Set them in Vercel → Project → Settings → Environment Variables, then redeploy.

# --- Transactional email via Resend (https://resend.com) — src/server/integrations/email.ts
# Resend API key, e.g. re_xxxxxxxx
EMAIL_API_KEY=
# Sender on a domain verified in Resend, e.g. "Adore Worship Movement <forms@your-domain.org>"
EMAIL_FROM=
# Optional comma-separated override. Defaults to adoreglobalnetwork@gmail.com
EMAIL_ADMIN_RECIPIENTS=

# --- Giving by bank transfer — src/server/giving.ts
# Shown only when all four are set and GIVING_DETAILS_VERIFIED=true.
GIVING_BANK_NAME=
GIVING_ACCOUNT_NAME=
# 10-digit NUBAN
GIVING_ACCOUNT_NUMBER=
# Set to "true" only after the organisers have confirmed the account.
GIVING_DETAILS_VERIFIED=

# --- Flutterwave card checkout (not implemented; not shown on the page) — src/server/integrations/flutterwave.ts
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
SITE_URL=
